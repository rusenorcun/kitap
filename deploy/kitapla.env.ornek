# /etc/kitapla.env olarak kopyalayın ve chmod 600 verin.
# Bu dosya sırlar içerir; depoya asla gerçek değerlerle konmaz.

# Yönetici hesabı (açılışta oluşturulur / yükseltilir)
KITAPLA_ADMIN_EMAIL=admin@kitapla.example.com
KITAPLA_ADMIN_PASSWORD=buraya-uzun-ve-rastgele-bir-parola
KITAPLA_ADMIN_NAME=Yonetici

# İletişim sayfasında gösterilecek destek adresi
KITAPLA_CONTACT_EMAIL=destek@kitapla.example.com

# Veri ve yüklenen dosyaların yolu (WorkingDirectory'ye göreli)
KITAPLA_DB=./data/kitapla
KITAPLA_UPLOAD_DIR=./uploads

# Uygulama portu (Caddy bu porta vekillik eder)
SERVER_PORT=8080

# --- E-posta ---
# Postadaki baglantilar bu adresle uretilir; MUTLAKA kendi alan adin olmali,
# yoksa kullaniciya localhost'a giden olu bir baglanti gider.
KITAPLA_BASE_URL=https://kitapla.example.com

KITAPLA_MAIL_ENABLED=true
KITAPLA_MAIL_FROM=destek@kitapla.example.com
KITAPLA_MAIL_FROM_NAME=KITAPLA

# SMTP bilgileri saglayiciya gore degisir; kod hepsiyle ayni sekilde calisir.
#   Resend : smtp.resend.com      / 587 / kullanici: resend, sifre: API anahtari
#   Brevo  : smtp-relay.brevo.com / 587
#   Gmail  : smtp.gmail.com       / 587 / uygulama sifresi gerekir
#   Yandex : smtp.yandex.com      / 465 (STARTTLS yerine SSL)
KITAPLA_SMTP_HOST=smtp.saglayici.com
KITAPLA_SMTP_PORT=587
KITAPLA_SMTP_USER=kullanici
KITAPLA_SMTP_PASSWORD=api-anahtari-ya-da-sifre
KITAPLA_SMTP_AUTH=true
KITAPLA_SMTP_STARTTLS=true

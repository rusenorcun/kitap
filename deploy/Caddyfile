# KİTAPLA — Caddy ters vekil yapılandırması
#
# Alan adı ve hedef ortam değişkeninden okunur; aynı dosya hem doğrudan
# kurulumda hem Docker'da çalışır:
#
#   Doğrudan kurulum (systemd):
#     /etc/caddy/caddy.env içine:  KITAPLA_DOMAIN=alanadin.com
#     (hedef varsayılanı 127.0.0.1:8080'dir, değiştirmeye gerek yok)
#
#   Docker (docker-compose.prod.yml):
#     .env içine:  KITAPLA_DOMAIN=alanadin.com
#                  KITAPLA_UPSTREAM=kitapla:8080
#
# Alan adının A/AAAA kaydı bu sunucunun IP'sine bakmalıdır.
#
# Caddy sertifikayı Let's Encrypt'ten otomatik alır ve yeniler; HTTP'den
# HTTPS'e yönlendirmeyi de kendisi yapar, ayrıca bir şey tanımlamaya gerek yok.

{$KITAPLA_DOMAIN:localhost} {
	# Uygulama dışarıya kapalıdır: doğrudan kurulumda 127.0.0.1'i dinler,
	# Docker'da ise portu ana makineye hiç yayınlanmaz.
	reverse_proxy {$KITAPLA_UPSTREAM:127.0.0.1:8080} {
		# Spring'in gerçek şemayı/istemciyi görebilmesi için:
		# server.forward-headers-strategy=framework ile birlikte çalışır.
		header_up X-Real-IP {remote_host}
	}

	encode zstd gzip

	header {
		# Tarayıcıya bir yıl boyunca yalnızca HTTPS kullanmasını söyle
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# MIME türü tahminini kapat
		X-Content-Type-Options "nosniff"
		# Siteyi başka bir sayfanın çerçevesine gömdürtme
		X-Frame-Options "SAMEORIGIN"
		# Dış sitelere tam URL sızdırma
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kullanılmayan tarayıcı yeteneklerini kapat
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# Sunucu imzasını gizle
		-Server
	}

	# Statik varlıklar uzun süre önbelleklenebilir.
	# ">" ertelenmiş kümeleme: Spring Security her yanıta "no-store" eklediği için
	# normal "header" ile iki çakışan Cache-Control kalıyor ve tarayıcı no-store'u
	# seçiyordu; ">" üstteki değeri yanıt üretildikten SONRA değiştirir.
	@statik path /css/* /js/* /webjars/* /uploads/covers/*
	header @statik >Cache-Control "public, max-age=604800"

	# Yüklenen kapak görselleri dışında bir şeyin gömülmesini engelle
	@belge path /admin/belge/*
	header @belge Cache-Control "no-store"

	log {
		output file /var/log/caddy/kitapla.log {
			roll_size 20mb
			roll_keep 10
		}
	}
}

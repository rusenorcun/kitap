# Docker ile yayına alma ayarları.
#   cp .env.ornek .env  &&  nano .env
# .env dosyası sırlar içerir ve depoya girmez (.gitignore'da).

# --- Alan adı ---
# Caddy sertifikayı bu ad için alır. DNS A kaydı sunucunun IP'sine bakmalı.
KITAPLA_DOMAIN=kitapla.example.com
KITAPLA_UPSTREAM=kitapla:8080

# Postalardaki ve yönlendirmelerdeki bağlantılar bu adresle üretilir
KITAPLA_BASE_URL=https://kitapla.example.com

# --- Yönetici hesabı (açılışta oluşturulur) ---
KITAPLA_ADMIN_EMAIL=admin@kitapla.example.com
KITAPLA_ADMIN_PASSWORD=buraya-uzun-ve-rastgele-bir-parola
KITAPLA_ADMIN_NAME=Yonetici

# --- İletişim sayfasında görünen adres ---
KITAPLA_CONTACT_EMAIL=destek@kitapla.example.com

# --- E-posta gönderimi ---
# false iken postalar yalnızca günlüğe yazılır (docker compose logs -f kitapla)
KITAPLA_MAIL_ENABLED=false
KITAPLA_MAIL_FROM=destek@kitapla.example.com
KITAPLA_MAIL_FROM_NAME=KITAPLA

# Sağlayıcına göre doldur; kod hepsiyle aynı şekilde çalışır.
#   Resend : smtp.resend.com      / 587 / kullanici: resend, sifre: API anahtari
#   Brevo  : smtp-relay.brevo.com / 587
#   Gmail  : smtp.gmail.com       / 587 / uygulama sifresi gerekir
KITAPLA_SMTP_HOST=smtp.saglayici.com
KITAPLA_SMTP_PORT=587
KITAPLA_SMTP_USER=kullanici
KITAPLA_SMTP_PASSWORD=api-anahtari
KITAPLA_SMTP_AUTH=true
KITAPLA_SMTP_STARTTLS=true
